          "mode": "raw",
          "raw": "{\r\n  \"properties\": {\r\n    \"email\": \"test{{$timestamp}}@example.com\",\r\n    \"firstname\": \"Test\",\r\n    \"lastname\": \"One\"\r\n  }\r\n}",
